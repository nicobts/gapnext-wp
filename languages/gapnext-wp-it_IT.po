# ── Settings page ─────────────────────────────────────────────────────────────

msgid "GapNext WP — Settings"
msgstr "GapNext WP — Impostazioni"

msgid "Settings saved."
msgstr "Impostazioni salvate."

msgid "Quick-start — required setup"
msgstr "Avvio rapido — configurazione necessaria"

msgid "Create a new WordPress page (e.g. \"Gap Analysis\") and paste this shortcode into the page content:"
msgstr "Crea una nuova pagina WordPress (es. \"Gap Analysis\") e incolla questo shortcode nel contenuto della pagina:"

msgid "Publish the page."
msgstr "Pubblica la pagina."

msgid "In the \"Checklist Page\" field below, select that page — this is where all audit links will send respondents."
msgstr "Nel campo \"Pagina Checklist\" qui sotto, seleziona quella pagina — è lì che tutti i link di audit indirizzeranno i rispondenti."

msgid "Go to Audit Links → Create a new audit link, share the generated URL with your client."
msgstr "Vai su Link di Audit → Crea un nuovo link di audit e condividi l'URL generato con il tuo cliente."

msgid "(Optional) Create a second page with this shortcode for a shareable web results page:"
msgstr "(Facoltativo) Crea una seconda pagina con questo shortcode per una pagina risultati condivisibile online:"

msgid "Then select it in the \"Results Page\" field below."
msgstr "Poi selezionala nel campo \"Pagina Risultati\" qui sotto."

msgid "The plugin will not work until a checklist page is created and selected below."
msgstr "Il plugin non funzionerà finché non viene creata e selezionata una pagina checklist."

msgid "Checklist Page"
msgstr "Pagina Checklist"

msgid "The page that contains the [gapnext_checklist] shortcode. Audit links will point here."
msgstr "La pagina che contiene lo shortcode [gapnext_checklist]. I link di audit punteranno qui."

msgid "Results Page"
msgstr "Pagina Risultati"

msgid "The page with [gapnext_results] shortcode. A \"View results online\" link will appear after submission."
msgstr "La pagina con lo shortcode [gapnext_results]. Un link \"Visualizza risultati online\" apparirà dopo l'invio."

msgid "— Select a page —"
msgstr "— Seleziona una pagina —"

msgid "— None (disable online results) —"
msgstr "— Nessuna (disabilita risultati online) —"

msgid "Default Language"
msgstr "Lingua Predefinita"

msgid "Default Access Mode"
msgstr "Modalità di Accesso Predefinita"

msgid "Public"
msgstr "Pubblico"

msgid "Login Required"
msgstr "Accesso Richiesto"

msgid "Consultant Logo"
msgstr "Logo Consulente"

msgid "Upload / Change Logo"
msgstr "Carica / Cambia Logo"

msgid "Select Logo"
msgstr "Seleziona Logo"

msgid "Use this logo"
msgstr "Usa questo logo"

msgid "Appears on the PDF report cover page. Falls back to the WordPress site logo if not set."
msgstr "Appare nella copertina del report PDF. Se non impostato, usa il logo del sito WordPress."

msgid "PDF Footer Text"
msgstr "Testo Piè di Pagina PDF"

msgid "Appears centred in the footer of every PDF report page."
msgstr "Appare centrato nel piè di pagina di ogni pagina del report PDF."

msgid "Notification Email"
msgstr "Email di Notifica"

msgid "Receives a copy of the submission notification email (in addition to the consultant). Leave blank to disable."
msgstr "Riceve una copia dell'email di notifica della risposta (in aggiunta al consulente). Lasciare vuoto per disabilitare."

msgid "Save Settings"
msgstr "Salva Impostazioni"

# ── Evidence file storage note (settings page) ───────────────────────────────

msgid "Evidence File Storage"
msgstr "Archiviazione File Evidenze"

msgid "When respondents upload evidence files during an audit, the files are saved inside the WordPress uploads directory using the following folder structure:"
msgstr "Quando i rispondenti caricano file di evidenza durante un audit, i file vengono salvati nella directory uploads di WordPress con la seguente struttura di cartelle:"

msgid "the unique identifier of the audit link (e.g. a1b2c3d4-…). Each audit gets its own subfolder, preventing file collisions between audits."
msgstr "l'identificatore univoco del link di audit (es. a1b2c3d4-…). Ogni audit ha la propria sottocartella, evitando collisioni tra file di audit diversi."

msgid "the question reference key (e.g. q-4_1, q-6_2). Each question gets its own subfolder so evidence stays organised per checklist item."
msgstr "la chiave di riferimento della domanda (es. q-4_1, q-6_2). Ogni domanda ha la propria sottocartella così le evidenze restano organizzate per elemento della checklist."

msgid "the original uploaded file name, sanitised by WordPress to prevent path-traversal issues. Multiple files per question are supported."
msgstr "il nome originale del file caricato, sanificato da WordPress per prevenire problemi di path-traversal. Sono supportati più file per domanda."

msgid "The absolute server path of each uploaded file is stored in the database (wp_gapnext_submissions.evidence_paths) as a JSON object keyed by question reference. On the results page these paths are automatically converted to public URLs so that linked files can be opened or downloaded directly in the browser."
msgstr "Il percorso assoluto del server di ogni file caricato è memorizzato nel database (wp_gapnext_submissions.evidence_paths) come oggetto JSON indicizzato per riferimento domanda. Nella pagina dei risultati questi percorsi vengono automaticamente convertiti in URL pubblici in modo che i file collegati possano essere aperti o scaricati direttamente nel browser."

msgid "Example path on this server: %s"
msgstr "Percorso di esempio su questo server: %s"

msgid "Note: evidence files are not managed by the WordPress Media Library. If you delete an audit or submission from the database, the files in the uploads folder must be removed manually."
msgstr "Nota: i file di evidenza non sono gestiti dalla Libreria Media di WordPress. Se si elimina un audit o una risposta dal database, i file nella cartella uploads devono essere rimossi manualmente."

